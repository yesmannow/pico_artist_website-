{
  "name": "pico_artist",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",

    "build:cloudflare": "npm run clean && npx @opennextjs/cloudflare build && rm -rf .open-next/output && mkdir -p .open-next/output && cp .open-next/worker.js .open-next/output/_worker.js && cp -R .open-next/cloudflare .open-next/output/cloudflare && cp -R .open-next/middleware .open-next/output/middleware && cp -R .open-next/server-functions .open-next/output/server-functions && cp -R .open-next/.build .open-next/output/.build && cp -R .open-next/assets/* .open-next/output/",

    "clean": "npx rimraf .next .open-next .vercel",
    "start": "next start",
    "lint": "npx eslint . --max-warnings=0",
    "optimize-media": "node scripts/optimize-media.js"
  },
  "dependencies": {
    "@next/bundle-analyzer": "^16.0.10",
    "@tsparticles/engine": "^3.9.1",
    "@tsparticles/react": "^3.0.0",
    "@tsparticles/slim": "^3.9.1",
    "ffmpeg-static": "^5.2.0",
    "framer-motion": "^12.23.26",
    "howler": "^2.2.4",
    "lucide-react": "^0.561.0",
    "next": "16.0.10",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-globe.gl": "^2.37.0",
    "react-lite-youtube-embed": "^3.3.3",
    "react-parallax-tilt": "^1.7.315",
    "sharp": "^0.34.5",
    "wavesurfer.js": "^7.12.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.14.6",
    "@tailwindcss/postcss": "^4",
    "@types/howler": "^2.2.12",
    "@types/node": "^25.0.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.0.10",
    "rimraf": "^6.1.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.55.0"
  }
}
